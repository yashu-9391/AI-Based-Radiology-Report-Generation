# Environment Configuration Example
# Copy this file to .env and set your keys if using cloud LLMs or custom dataset locations

# Custom Dataset Directories (Optional override)
CHEXPERT_PATH=datasets/chexpert
IU_XRAY_PATH=datasets/iu_xray

# LLM & Embedding API Keys (Optional if using local SLM / Rule-based engine)
OPENAI_API_KEY="your_openai_api_key_here"
HUGGINGFACE_TOKEN="your_huggingface_token_here"

# Hardware Acceleration Override (Optional: cuda / cpu)
DEVICE_OVERRIDE=auto
